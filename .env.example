VITE_GATE_PASSWORD=changeme
VITE_MASTER_EMAIL=admin@example.com

# Firebase App Check (reCAPTCHA v3 site key).
# Create at: Firebase Console -> App Check -> Apps -> register the web app with
# reCAPTCHA v3. The site key is public and safe to ship; the SECRET key stays in the
# console. Without this the app still runs, but its requests are unattested and will be
# rejected once App Check enforcement is switched on.
VITE_RECAPTCHA_SITE_KEY=

# Local development only. App Check blocks localhost unless you register a debug token:
# set this to `true`, run the dev server, copy the token the browser console prints, and
# add it under App Check -> Manage debug tokens. Never set this in a production build.
VITE_APPCHECK_DEBUG_TOKEN=
