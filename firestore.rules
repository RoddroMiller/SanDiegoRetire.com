rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthenticated() {
      // Signed in AND not anonymous
      return isSignedIn()
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isMaster() {
      return isAuthenticated()
          && (request.auth.token.email.lower() == 'rmiller@millerwm.com'
              || request.auth.token.get('role', '') == 'master');
    }

    // Role comes from a server-set custom auth claim (functions/index.js setUserRole),
    // NOT from anything the client can influence. Users without a claim get no
    // advisor privileges — they can still reach plans assigned to their own email.
    function isAdvisor() {
      return isAuthenticated() && request.auth.token.get('role', '') == 'advisor';
    }

    // Team ids and legacy teammate emails ride along in the same claim so team
    // visibility can be enforced server-side instead of filtered in the browser.
    function myTeams() {
      return request.auth.token.get('teams', []);
    }

    function myTeamEmails() {
      return request.auth.token.get('teamEmails', []);
    }

    function isOwner(resource) {
      return isAuthenticated()
          && (resource.data.advisorId == request.auth.uid
              || resource.data.advisorEmail.lower() == request.auth.token.email.lower());
    }

    function isAssignedClient(resource) {
      return isAuthenticated()
          && resource.data.get('assignedClientEmail', '').lower() == request.auth.token.email.lower();
    }

    // Unclaimed prospect plans (wizard submissions / saved progress). Advisors work
    // these as a shared inbox, so any advisor may read them.
    function isProspectPlan(resource) {
      return resource.data.advisorId in ['CLIENT_SUBMISSION', 'CLIENT_PROGRESS'];
    }

    function isTeamPlan(resource) {
      return resource.data.get('teamId', null) != null
          && resource.data.teamId in myTeams();
    }

    // Dual-path for plans saved before the team migration: visible to teammates by
    // the creator's email. Drops away once plans carry a teamId.
    function isLegacyTeammatePlan(resource) {
      return resource.data.get('teamId', null) == null
          && resource.data.get('advisorEmail', '').lower() in myTeamEmails();
    }

    // ─── Scenarios ──────────────────────────────────────────────────
    // Path: artifacts/portfolio-architect/public/data/scenarios/{scenarioId}

    match /artifacts/{appId}/public/data/scenarios/{scenarioId} {

      // Read is per-document and must match how the app queries (useScenarios.js):
      // master reads all; advisors query their own plans, their teams' plans and the
      // prospect inbox; registered clients query only plans assigned to their email.
      // Anonymous sessions get nothing — the wizard writes progress but never reads
      // the collection, so denying them costs no functionality and closes the hole
      // where any visitor could read every saved plan.
      allow read: if isMaster()
        || isOwner(resource)
        || isAssignedClient(resource)
        || (isAdvisor() && (isProspectPlan(resource)
                            || isTeamPlan(resource)
                            || isLegacyTeammatePlan(resource)));

      // Create: authenticated users must stamp their own identity.
      // Anonymous/client users can create CLIENT_SUBMISSION or CLIENT_PROGRESS docs.
      allow create: if isSignedIn()
        && (
          // Advisor/master creating a plan — must hold the role AND stamp own identity.
          // The role check stops a self-registered client account from creating
          // advisor-owned plans (which previously also self-granted advisor status).
          ((isAdvisor() || isMaster())
            && request.resource.data.advisorId == request.auth.uid
            && request.resource.data.advisorEmail.lower() == request.auth.token.email.lower())
          ||
          // Anonymous or any signed-in user creating a client submission/progress
          (request.resource.data.advisorId in ['CLIENT_SUBMISSION', 'CLIENT_PROGRESS'])
        );

      // Update: owner, assigned client (limited), master, or anonymous updating own progress
      allow update: if isSignedIn()
        && (
          // Owner can update their own scenarios
          isOwner(resource)
          ||
          // Master can update any scenario
          isMaster()
          ||
          // Assigned client can update but CANNOT change ownership fields
          (isAssignedClient(resource)
            && (!request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['advisorId', 'advisorEmail'])))
          ||
          // Anonymous/client users can update their own CLIENT_PROGRESS docs
          (resource.data.advisorId == 'CLIENT_PROGRESS'
            && request.resource.data.advisorId == 'CLIENT_PROGRESS')
        );

      // Delete: owner or master only
      allow delete: if isOwner(resource) || isMaster();
    }

    // ─── Advisors ───────────────────────────────────────────────────
    // Path: artifacts/portfolio-architect/public/data/advisors/{advisorId}

    match /artifacts/{appId}/public/data/advisors/{advisorId} {
      // Any authenticated (non-anonymous) user can read the advisor directory
      allow read: if isAuthenticated();

      // Master can create/update/delete any advisor entry
      // Authenticated users can create or update their own entry (email must match)
      allow create, update: if isMaster()
        || (isAuthenticated()
            && request.resource.data.email.lower() == request.auth.token.email.lower());

      // Only master can delete advisor entries
      allow delete: if isMaster();
    }

    // ─── Security Records ───────────────────────────────────────────
    // Path: security/users/{hashedEmail}/data
    //
    // Fully locked down — all access goes through Cloud Functions
    // (checkAccountLockout, recordFailedAttempt, etc.) which use the
    // admin SDK and bypass these rules.

    match /security/users/{hashedEmail}/data {
      allow read, write: if false;
    }

    // ─── Audit Logs ─────────────────────────────────────────────────
    // Path: audit_logs/{logId}
    //
    // Read: master only.
    // Write: denied from client — only Cloud Functions admin SDK can write.

    match /audit_logs/{logId} {
      allow read: if isMaster();
      allow write: if false;
    }

    // ─── Catch-all ──────────────────────────────────────────────────
    // Deny everything not explicitly matched above.
    // (Firestore denies by default, but this makes it explicit.)
  }
}
